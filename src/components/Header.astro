---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="topbar">
		<a href="/" class="site-title">{SITE_TITLE}</a>
		<nav class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
	</div>

	<div class="profile">
		<div class="avatar">文</div>
		<div class="profile-text">
			<p class="name">文中（ぶんちゅう）</p>
			<p class="bio">SES / 8年目 / 4歳と1歳の父</p>
		</div>
		<div class="profile-links">
			<a href="https://github.com/0830tandy-oss" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href="/rss.xml" aria-label="RSSフィード">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16"
					><path
						fill="currentColor"
						d="M2 2v2.4C7.9 4.4 12.6 9.1 12.6 15H15c0-7.2-5.8-13-13-13zm0 5.4v2.4c2.9 0 5.2 2.3 5.2 5.2h2.4c0-4.2-3.4-7.6-7.6-7.6zM3.6 12a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2z"
					></path></svg
				>
			</a>
		</div>
	</div>
</header>
<style>
	header {
		background: var(--bg);
		border-bottom: 1px solid var(--border);
	}
	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 640px;
		margin: 0 auto;
		padding: 1.5em 1em 0;
	}
	.site-title {
		font-family: var(--font-serif);
		font-size: 0.95em;
		letter-spacing: 0.04em;
		color: var(--text-secondary);
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		gap: 1.2em;
	}
	:global(.internal-links a) {
		color: var(--text-secondary);
		font-size: 0.85em;
		text-decoration: none;
		padding: 0.3em 0;
	}
	:global(.internal-links a.active) {
		color: var(--accent);
		font-weight: 500;
		text-decoration: none;
		border-bottom: 2px solid var(--accent);
	}
	.profile {
		max-width: 640px;
		margin: 0 auto;
		padding: 1.2em 1em 2.5em;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.8em;
	}
	.avatar {
		width: 56px;
		height: 56px;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-family: var(--font-serif);
		font-size: 1.4em;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.profile-text {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
	}
	.name {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.05em;
		font-weight: 700;
		color: var(--text);
	}
	.bio {
		margin: 0;
		font-size: 0.72em;
		color: var(--muted);
	}
	.profile-links {
		display: flex;
		gap: 0.6em;
	}
	.profile-links a {
		width: 30px;
		height: 30px;
		border-radius: 999px;
		background: #f1efe9;
		color: #5c5952;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: 0.15s ease;
	}
	.profile-links a:hover {
		background: var(--accent);
		color: #fff;
	}
	@media (max-width: 720px) {
		.internal-links {
			gap: 0.8em;
		}
	}
</style>
